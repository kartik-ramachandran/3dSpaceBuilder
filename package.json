{
  "name": "3d-space-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt-to-3D space builder: describe a plane, hotel or office and explore it in the browser with priced zones and window views.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/serve.mjs 5173",
    "build": "node scripts/build.mjs",
    "test": "node tests/smoke.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "test:references": "node tests/references.mjs && node tests/reference-ui.mjs",
    "test:stadium": "node tests/stadium.mjs",
    "test:hover": "node tests/hover.mjs",
    "test:development": "node tests/development.mjs",
    "test:startup": "node tests/startup.mjs",
    "test:valuations": "node tests/valuations.mjs",
    "test:gestures": "node tests/gestures.mjs",
    "test:thane": "node tests/thane.mjs",
    "test:residential-detail": "node tests/residential-detail.mjs",
    "test:site-layers": "node tests/site-layers.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright": "1.49.1",
    "three": "0.160.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "maplibre-gl": "^4.7.1",
    "pdf-lib": "^1.17.1"
  }
}
